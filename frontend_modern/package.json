{
  "name": "openshiksha-frontend",
  "version": "2.0.0",
  "type": "module",
  "description": "OpenShiksha Modern Frontend - React 19 + TypeScript",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:analyze": "tsc && vite build --mode analyze",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "check:audit": "node scripts/check-npm-audit.mjs",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:e2e:visual": "playwright test --grep @visual",
    "test:e2e:update-snapshots": "playwright test --grep @visual --update-snapshots",
    "lighthouse": "npx --yes @lhci/cli@0.14.0 autorun",
    "widget:new": "node scripts/create-widget.mjs",
    "widget:dev": "node scripts/widget-dev.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.69.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "axios": "^1.19.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.12",
    "idb-keyval": "^6.3.0",
    "katex": "^0.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-katex": "^3.0.1",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/dompurify": "^3.2.0",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.8",
    "axe-core": "^4.12.1",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
