# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION-use-python-secrets-token-urlsafe
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=openshiksha.settings.development

# Database Configuration
DATABASE_URL=postgresql://openshiksha:openshiksha@localhost:5432/openshiksha_dev
DB_CONN_MAX_AGE=600

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Cabinet Service Integration
CABINET_API_URL=http://localhost:9000
CABINET_API_KEY=dev-cabinet-key-replace-in-production
CABINET_TIMEOUT=30

# AI / LLM (all optional) — provider cascade for explanations & drafts:
#   1. Anthropic Claude — set ANTHROPIC_API_KEY
#   2. Google Gemma     — set GOOGLE_AI_API_KEY (free via Google AI Studio)
#   3. Ollama (local)   — set OLLAMA_BASE_URL, or run Ollama at localhost:11434
#   4. Stub fallback    — plain text, no keys needed (default for local dev)
# Leave these blank to develop against the stub; grading/analytics don't need them.
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# JWT Authentication
JWT_SECRET_KEY=jwt-secret-CHANGE-THIS-IN-PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME=604800

# Email Configuration (Console backend for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@openshiksha.org

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/openshiksha.log

# CORS (Frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Media & Static Files
MEDIA_URL=/media/
MEDIA_ROOT=media/
STATIC_URL=/static/
STATIC_ROOT=staticfiles/

# Feature Flags
ENABLE_DEBUG_TOOLBAR=True
ENABLE_SILK_PROFILER=False
ENABLE_API_DOCS=True

# Security (Production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
