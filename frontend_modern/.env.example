# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT=30000

# WebSocket Configuration
VITE_WS_URL=ws://localhost:8000/ws

# Cabinet Service
VITE_CABINET_URL=http://localhost:9000

# Authentication
VITE_JWT_STORAGE_KEY=openshiksha_access_token
VITE_REFRESH_TOKEN_STORAGE_KEY=openshiksha_refresh_token

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_DEBUG_MODE=true
VITE_ENABLE_MOCK_API=false

# App Configuration
VITE_APP_NAME=OpenShiksha
VITE_APP_VERSION=2.0.0-dev
VITE_ENV=development

# Sentry (Error Tracking - optional)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_SAMPLE_RATE=1.0
