[flake8]
max-line-length = 130
# E203: whitespace before ':' — conflicts with black's slice formatting
# W503: line break before binary operator — conflicts with black
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    */migrations/*,
    staticfiles,
    media
per-file-ignores =
    # Test files: allow long lines for fixtures/parametrize
    tests/test_*.py:E501
    */tests/test_*.py:E501
